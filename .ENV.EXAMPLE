# .env.example - Variables d'environnement
# Copier ce fichier en .env et modifier selon vos besoins

# Application
ENV=production
SECRET_KEY=votre_secret_key_ici
DEBUG=False

# Base de données (si vous ajoutez PostgreSQL)
# DATABASE_URL=postgresql://user:password@postgres:5432/harmony

# Redis (si vous ajoutez Redis)
# REDIS_URL=redis://redis:6379

# MLflow
MLFLOW_TRACKING_URI=http://web:5000
MLFLOW_BACKEND_STORE_URI=sqlite:///mlruns/mlflow.db

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# JWT
JWT_SECRET_KEY=votre_jwt_secret
JWT_ALGORITHM=HS256

# Email (optionnel)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=user@gmail.com
# SMTP_PASSWORD=password